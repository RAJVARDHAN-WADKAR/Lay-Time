# Lay-Time / Demurrage Claim Management System Environment Configuration
# Copy this file to .env.local for local development.

# Application Environment
NODE_ENV=development
PORT=3000

# Authentication & Session Security
# Provide a strong, cryptographically secure 256-bit or 512-bit secret for signing JWT session tokens.
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_for_security

# Database Path (defaults to data/laytime.db relative to project root)
DATABASE_PATH=data/laytime.db
NEXT_TELEMETRY_DISABLED=1

# Seed User Passwords (MANDATORY: scripts/seed-users.js refuses to run without these)
ADMIN_PASSWORD=AdminSecurePass@2024!
SUPERVISOR_PASSWORD=SuperSecurePass@2024!
PROCESSOR1_PASSWORD=Proc1SecurePass@2024!
PROCESSOR2_PASSWORD=Proc2SecurePass@2024!
REVIEWER_PASSWORD=ReviewerSecurePass@2024!
CLIENT_PASSWORD=ClientSecurePass@2024!
